# Copy to .env and replace the local development credentials.
DATABASE_URL=postgresql+psycopg://tenant_app:replace-me@localhost:5432/tenant_control_plane
RABBITMQ_URL=amqp://tenant_app:replace-me@localhost:5672/tenant_control_plane
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
OUTBOX_POLL_SECONDS=1.0
OUTBOX_RETRY_BASE_SECONDS=1.0
OUTBOX_RETRY_MAX_SECONDS=30.0
INBOUND_RETRY_SECONDS=2.0
INBOUND_RETRY_MAX_SECONDS=30.0
INBOUND_RETRY_MAX_ATTEMPTS=5
WORKER_FAIL_RATE=0.0
WORKER_MIN_DELAY_MS=250
WORKER_MAX_DELAY_MS=1000

# Set this to a separate, disposable PostgreSQL database for integration tests.
TEST_DATABASE_URL=postgresql+psycopg://tenant_app:replace-me@localhost:5432/tenant_control_plane_test
TEST_RABBITMQ_URL=amqp://tenant_app:replace-me@localhost:5672/tenant_control_plane_test
